# Copy to /opt/opendomain/.env on the Vultr host, then set mode 0600.
# Do not commit the filled-in file or copy secrets into shell history.

# Canonical public hostname. Point its A record at the Vultr VM before starting Caddy.
OPENDOMAIN_HOSTNAME=app.example.com
CADDY_EMAIL=ops@example.com

ENVIRONMENT=production
APP_URL=https://app.example.com
API_URL=https://app.example.com
CORS_ORIGINS=["https://app.example.com"]
COOKIE_SECURE=true
# Leave blank for a host-only session cookie.
COOKIE_DOMAIN=

# Generate distinct secrets. Examples:
# openssl rand -base64 48
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SECRET_KEY=
AUTH_ENCRYPTION_KEY=
TOKEN_PEPPER=

POSTGRES_USER=opendomain
POSTGRES_PASSWORD=
POSTGRES_DB=opendomain

# These are injected by Compose with the internal db and redis service names.
# Do not set DATABASE_URL or REDIS_URL to publicly reachable addresses.

# Configure a verified Resend domain and sender before launching.
RESEND_API_KEY=
MAIL_FROM=OpenDomain <no-reply@example.com>

# Initial launch is application-only: do not enable unimplemented live services.
EPP_SIMULATE=true
# Leave Bedrock credentials unset unless the agent is explicitly enabled with spend controls.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: a mounted, encrypted off-host backup target used by backup.sh.
BACKUP_DESTINATION=
