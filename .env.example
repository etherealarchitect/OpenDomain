# Database
DATABASE_URL=postgresql+asyncpg://opendomain:opendomain@localhost:5432/opendomain
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://localhost:6379/0

# Security — generate unique production values; never commit a real secret.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-secret-key
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AUTH_ENCRYPTION_KEY=
# Optional dedicated HMAC pepper for opaque token/session digests.
TOKEN_PEPPER=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_EXPIRE_DAYS=14
AUTH_CHALLENGE_EXPIRE_MINUTES=10
AUTH_TOKEN_EXPIRE_MINUTES=30
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Transactional email (Resend)
# Production requires a verified sender and a RESEND_API_KEY deployment secret.
RESEND_API_KEY=
MAIL_FROM=OpenDomain <onboarding@resend.dev>

# AI Agent (Bedrock)
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ANTHROPIC_MODEL=anthropic.claude-fable-5

# EPP Registry Connection
EPP_HOST=epp.registry.example
EPP_PORT=700
EPP_CLIENT_ID=
EPP_PASSWORD=
EPP_CERT_PATH=./certs/epp-client.pem
EPP_KEY_PATH=./certs/epp-client-key.pem
EPP_SIMULATE=true

# DNS
DNS_PROVIDER=powerdns
POWERDNS_API_URL=http://localhost:8081
POWERDNS_API_KEY=change-me

# WHOIS
WHOIS_PRIVACY_DEFAULT=true

# App
APP_NAME=OpenDomain
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
