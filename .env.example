# Database
DATABASE_URL=postgresql+asyncpg://opendomain:opendomain@localhost:5432/opendomain
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Agent (Bedrock)
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ANTHROPIC_MODEL=anthropic.claude-fable-5

# EPP Registry Connection
EPP_HOST=epp.registry.example
EPP_PORT=700
EPP_CLIENT_ID=
EPP_PASSWORD=
EPP_CERT_PATH=./certs/epp-client.pem
EPP_KEY_PATH=./certs/epp-client-key.pem
EPP_SIMULATE=true

# DNS
DNS_PROVIDER=powerdns
POWERDNS_API_URL=http://localhost:8081
POWERDNS_API_KEY=change-me

# WHOIS
WHOIS_PRIVACY_DEFAULT=true

# App
APP_NAME=OpenDomain
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
