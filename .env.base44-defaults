# Development placeholders for the Base44 sandbox.
#
# This file is listed BEFORE /run/base44/app.env in docker-compose.base44.yml, so a
# real value stored in the Base44 dashboard always overrides anything here. Only
# values required to boot without credentials belong in this file.
#
# SECRET_KEY can be any 32+ character string in development; production requires a
# strong, unique value (the app refuses to start in production with a weak one).
SECRET_KEY=dev-only-placeholder-secret-key-change-me-32chars

# AUTH_ENCRYPTION_KEY and TOKEN_PEPPER are intentionally unset: the backend derives
# both from SECRET_KEY when they are absent.
