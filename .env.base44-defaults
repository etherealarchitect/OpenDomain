# Non-secret development defaults for the Base44 sandbox stack.
#
# Loaded FIRST in docker-compose.base44.yml, so every value here is overridden
# by the platform-managed /run/base44/app.env (listed last). Committed on
# purpose: it only carries placeholders, never real credentials.
ENVIRONMENT=development

# Placeholder only — the real SECRET_KEY arrives from /run/base44/app.env.
SECRET_KEY=base44-local-development-placeholder-secret-key-32

# Transactional email is optional in development; without a key the mail
# service is skipped and sign-up flows still work.
RESEND_API_KEY=
