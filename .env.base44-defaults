# Development-only defaults for the Base44 sandbox stack (docker-compose.base44.yml).
#
# This file is listed FIRST in each service's `env_file:` list, so any value the
# platform delivers to /run/base44/app.env overrides the placeholder below.
# Never put a real credential in this file.

ENVIRONMENT=development

# Local infrastructure (credentials are generated for the sandbox, not user secrets).
DATABASE_URL=postgresql+asyncpg://opendomain:opendomain@db:5432/opendomain
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0

# Placeholder only — the platform-delivered SECRET_KEY wins over this value.
SECRET_KEY=base44-sandbox-placeholder-secret-key-replace-me
COOKIE_SECURE=false
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# DNS publishing target: the PowerDNS service in docker-compose.base44.yml.
DNS_PROVIDER=powerdns
POWERDNS_API_URL=http://powerdns:8081
POWERDNS_API_KEY=change-me

# Registry access stays simulated until real EPP credentials and client
# certificates are mounted (see docs/API.md and the evaluation doc).
EPP_SIMULATE=true

WHOIS_PRIVACY_DEFAULT=true

# Transactional email (RESEND_API_KEY) and the AI agent's Bedrock credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) are user-supplied secrets delivered
# through /run/base44/app.env. With no Resend key, mail is logged, not sent.
