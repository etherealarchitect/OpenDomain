{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenDomain API",
    "description": "Open-source domain registrar platform with integrated AI agent",
    "version": "0.1.0",
    "license": {
      "name": "MIT",
      "url": "https://github.com/etherealarchitect/OpenDomain/blob/main/LICENSE"
    },
    "contact": {
      "name": "API Support",
      "url": "https://github.com/etherealarchitect/OpenDomain/issues"
    }
  },
  "servers": [
    {
      "url": "https://api.opendomain.dev/api/v1",
      "description": "Production API"
    },
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local development"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "description": "Start authentication flow with email and password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication challenge returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthChallenge"
                }
              }
            }
          }
        }
      }
    },
    "/domains": {
      "get": {
        "summary": "List domains",
        "description": "Retrieve list of domains for authenticated user",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Domain"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register domain",
        "description": "Register a new domain",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DomainRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Domain registration initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Domain"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          }
        }
      },
      "AuthChallenge": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "next_step": {
            "type": "string",
            "enum": ["mfa_verify", "mfa_enrollment", "complete"]
          }
        }
      },
      "Domain": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "example.com"
          },
          "status": {
            "type": "string",
            "enum": ["active", "pending", "expired", "suspended"]
          },
          "expiry_date": {
            "type": "string",
            "format": "date-time"
          },
          "auto_renew": {
            "type": "boolean"
          },
          "privacy_enabled": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          }
        }
      },
      "DomainRegistration": {
        "type": "object",
        "required": ["domain", "period_years"],
        "properties": {
          "domain": {
            "type": "string",
            "example": "example.com"
          },
          "period_years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "privacy_enabled": {
            "type": "boolean",
            "default": true
          },
          "auto_renew": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}